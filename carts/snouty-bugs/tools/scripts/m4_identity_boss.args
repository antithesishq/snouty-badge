# m4_identity_boss: m3_boss's input (god at 31; since M7 the warp is at 1700, see m3_boss):
# identity through the Heisenbug's three HP phases (breaks at 2304 and 2664, each cancelling
# the bullets and dropping a crate), its teleports, the death sequence (HP out at 3360, clear
# at 3421) and the breather into stage 2 (its table from 3541). 0 on every frame from 31 when
# re-pinned for the mode paces (until then the breaks were pinned at 2484 and 2939, HP out at
# 3601, the clear at 3662 and stage 2's table at 3782; those pins stay as samples).
--frames 3950 --call-at "31 debug_god" --call-at "1700 debug_warp" --dump-exports debug_state,debug_stage_clears --at "1800 debug_history_check == 0" --at "2100 debug_history_check == 0" --at "2304 debug_history_check == 0" --at "2305 debug_history_check == 0" --at "2484 debug_history_check == 0" --at "2485 debug_history_check == 0" --at "2800 debug_history_check == 0" --at "2664 debug_history_check == 0" --at "2939 debug_history_check == 0" --at "3200 debug_history_check == 0" --at "3360 debug_history_check == 0" --at "3421 debug_history_check == 0" --at "3500 debug_history_check == 0" --at "3541 debug_history_check == 0" --at "3630 debug_history_check == 0" --at "3662 debug_history_check == 0" --at "3700 debug_history_check == 0" --at "3800 debug_history_check == 0" --at "3949 debug_history_check == 0" --expect "debug_stage_clears == 1"
