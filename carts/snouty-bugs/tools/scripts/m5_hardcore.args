# m5_hardcore: B at 30 on the title starts a hardcore game (state 1 on that update, hardcore
# 1, rewinds 0, fuel 180), then the ship idles into the stage-1 wasp's ram as in m2_hit
# (since M7; until M7 the 8 s beetle's spread at 748). First hit at 524 (game tick 494): the
# rewind is paid from the bar, depth min(120, 180) = 120, fuel 180 -> 60, target 374, 20 + 60
# frames, resume at 604 with game tick 374. The idle ship replays its fate: the fuel is 60 +
# 12 refills = 72 at 723. Second hit at 724: depth 72, target 422, fuel 0, (72 + 1) / 2 = 36
# playback frames, resume at 780 with game tick 422. Third hit at 852 with fuel 7 (7 refills
# in 72 live ticks) < the floor of 45: DYING (state 3), then TITLE at 912 (60 updates later).
--frames 1000 --dump-exports debug_state,debug_hardcore,debug_rewinds,debug_fuel --at "30 debug_state == 1" --at "30 debug_hardcore == 1" --at "30 debug_rewinds == 0" --at "30 debug_fuel == 180" --at "523 debug_state == 1" --at "524 debug_state == 4" --at "524 debug_game_tick == 494" --at "524 debug_rewind_target == 374" --at "524 debug_fuel == 60" --at "524 debug_rewinds == 0" --at "603 debug_state == 4" --at "604 debug_state == 1" --at "604 debug_game_tick == 374" --at "650 debug_history_check == 0" --at "723 debug_fuel == 72" --at "724 debug_state == 4" --at "724 debug_rewind_target == 422" --at "724 debug_fuel == 0" --at "779 debug_state == 4" --at "780 debug_state == 1" --at "780 debug_game_tick == 422" --at "800 debug_history_check == 0" --at "851 debug_state == 1" --at "852 debug_state == 3" --at "852 debug_fuel == 7" --at "911 debug_state == 3" --at "912 debug_state == 0" --expect "debug_state == 0" --expect "debug_hardcore == 1"
