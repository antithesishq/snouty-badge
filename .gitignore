.zig-cache/
zig-out/
zig-pkg/
node_modules/
.venv/
__pycache__/
*.pyc
*.uf2
*.elf
*.wasm
.DS_Store
# Scratch output at the root: drive images and bench runs (docs/RUNNING.md
# of snouty-boy, section 9.1).
/out/
# badge-manager/build-job.sh scratch: job worktrees, previews, bench runs.
/build-jobs/

# Game Gear / Master System ROMs: commercial ones stay outside the repo
*.gg
*.sms

# The shipped Snouty Gear ROM (MIT, roms/LICENSE-waternet) is the one exception.
!carts/snouty-gear/roms/waternet.gg

# Genesis / Mega Drive ROMs (carts/snouty-genesis/SPEC.md section 11):
# commercial ones stay outside the repo. `*.md` cannot be a global pattern
# (it would ignore Markdown), so .bin and .md ROMs are ignored by path; the
# shipped ROMs' exception lines follow.
*.gen
*.smd
carts/snouty-genesis/roms/*.bin
carts/snouty-genesis/roms/*.md
carts/snouty-genesis/tests/roms/

# Snouty Genesis shipped ROMs (roms/LICENSE-*). These exceptions must stay
# BELOW the Genesis ROM ignore patterns (*.gen, *.smd and the roms/*.bin,
# roms/*.md, tests/roms/ path rules of SPEC.md section 11), since the last
# matching line wins.
!carts/snouty-genesis/roms/snouty-test.bin
!carts/snouty-genesis/roms/miniplanets.bin

# Atari Lynx ROMs (carts/snouty-lynx/SPEC.md section 11): commercial ones stay
# outside the repo. Exceptions for shipped ROMs go BELOW these lines (the last
# matching line wins).
*.lnx
*.lyx
!carts/snouty-lynx/roms/placeholder.lnx
